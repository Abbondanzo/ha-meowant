MEOWANT_EMAIL=you@example.com
MEOWANT_PASSWORD=your-meowant-password
# Two-letter ISO country code chosen at signup (e.g. US), not the phone prefix. Defaults to US.
MEOWANT_AREA_CODE=
# Dev only: route the login test page through HTTP Toolkit (TLS verification off).
# MEOWANT_DEBUG_PROXY=http://127.0.0.1:8000
# Optional fixed client install ID (32 hex); otherwise one is generated into .dev_device_id.
MEOWANT_DEVICE_ID=
